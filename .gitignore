# devenv.sh (https://devenv.sh)
/.devenv/
devenv.lock

# CMake / Ninja
build/
build-*/
cmake-build-*/

# Python
__pycache__/
*.pyc
.venv/

# Build / packaging
*.egg-info/

# Tooling caches (uv, ruff, ty, pytest)
.cache/
.pytest_cache/
.ruff_cache/
.ty_cache/
# uv.lock is the committed dependency lock; keep it tracked.

# OMO local state — boulder.json, plans, drafts, notepads, evidence,
# run-continuation, etc. None of this is source of truth.
# (Originally only `.omo/evidence/` was ignored; widened to the whole dir
#  because plans/drafts/notepads/boulder.json are also ephemeral runtime
#  state and not part of the repo source.)
/.omo/

# OMX runtime cache (metrics.json, logs/, state/)
/.omx/

# codegraph index symlink — points at a per-project cache outside the repo
/.codegraph

## lit FileCheck
# Auto-generated by every `lit -v` run; not source code.
compiler/test/.lit_test_times.txt
compiler/test/**/.lit_test_times.txt
